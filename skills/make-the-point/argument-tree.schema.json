{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unfriction.ai/schemas/argument-tree.json",
  "title": "ArgumentTree",
  "description": "Canonical make-the-point output. Prose is optional and must derive from this tree.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mode",
    "source",
    "scqa",
    "governingThought",
    "horizontalLogic",
    "keyLine"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": ["analyze", "construct"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["text", "link", "image"]
        },
        "ref": {
          "type": "string",
          "minLength": 1, "pattern": "\\S",
          "description": "URL, file path, or omitted when the text was inlined in the prompt."
        },
        "excerpt": {
          "type": "string",
          "minLength": 1, "pattern": "\\S",
          "description": "Short note of what was ingested; not the full source."
        }
      }
    },
    "scqa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["situation", "complication", "question", "answer"],
      "properties": {
        "situation": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "complication": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "question": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "answer": {
          "type": "string",
          "minLength": 1, "pattern": "\\S",
          "description": "Must match governingThought."
        }
      }
    },
    "governingThought": {
      "type": "string",
      "minLength": 1, "pattern": "\\S",
      "description": "Single main point the audience must remember. Same string as scqa.answer."
    },
    "horizontalLogic": {
      "enum": ["inductive", "deductive"],
      "description": "How keyLine siblings relate. inductive = grouped reasons of the same kind. deductive = chained major→minor→conclusion."
    },
    "keyLine": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "prose": {
      "type": "string",
      "minLength": 1, "pattern": "\\S",
      "description": "Pyramid-order prose generated from the tree, or a reconstruction that mirrors it. Never invent claims absent from the tree."
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" },
      "description": "Doubts about the tree as a whole, such as a missing reason, an assumption, or a MECE risk. Doubt about one claim's evidence goes in that leaf's evidenceGap. Not part of the argument. The diagram lists them under Caveats."
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "role"],
      "anyOf": [
        { "required": ["children"] },
        { "required": ["support"], "properties": { "support": { "minItems": 1 } } },
        { "required": ["evidenceGap"] }
      ],
      "not": { "required": ["children", "evidenceGap"] },
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "claim": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "role": {
          "enum": ["reason", "evidence", "example", "rebuttal"]
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        },
        "support": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "description": "Facts or observations from the source that back this claim. No links or citations."
        },
        "evidenceGap": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Why the evidence for this one claim is missing or thin. Leaves only. With no support lines the diagram marks the claim Unsupported, with support lines Weak support. No links or citations."
        }
      }
    }
  }
}
